# LLM transport (see pipeline/llm/transport.py). Default: shells out to the `claude` CLI,
# drawing on your Claude Code subscription rather than metered API credits.
CONTENT_JUDGE_TRANSPORT=cli   # cli | sdk | off
CONTENT_CLAUDE_BIN=           # optional: override the `claude` binary path
CONTENT_JUDGE_CLI_MODEL=sonnet
CONTENT_JUDGE_TIMEOUT=180

# Only consulted when CONTENT_JUDGE_TRANSPORT=sdk
ANTHROPIC_API_KEY=
