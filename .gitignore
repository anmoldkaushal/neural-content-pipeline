.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env

# Job artifacts -- generated at runtime, never committed.
output/*
!output/.gitkeep

# Working briefs for real clients -- not the versioned test fixtures, never committed.
local_briefs/

# Real clients never enter git (their facts, rules and documents are client material); the
# synthetic exemplar and the blank template are the exceptions (safe/empty by construction).
clients/*
!clients/exemplar/
!clients/_template/
clients/*/profile_review.json

# macOS Finder metadata
.DS_Store

# Claude Code local state (worktrees, settings)
.claude/
